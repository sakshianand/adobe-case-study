# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. This file documents which env vars exist and
# what they're for; it should never itself contain a real credential.

# Groq API key — used for AI Quality Summary + RAG assistant phrasing (Groq LLM calls).
GROQ_API_KEY=

# Signs/verifies session JWTs (services/auth/jwt.js). If unset, a random
# secret is generated per process start — fine for local dev (sessions just
# reset on restart), but MUST be set to a real, long, random value in any
# shared/deployed environment so sessions survive a restart and can't be
# forged. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Origin the frontend is served from — required for the session cookie to
# be set/sent correctly cross-origin (CORS credentials mode needs an exact
# origin, not a wildcard).
FRONTEND_ORIGIN=http://localhost:5173

# Set to "production" to mark the session cookie Secure (HTTPS-only).
NODE_ENV=development
